{
  "manifest_version": 3,
  "name": "Novel Book Reader",
  "version": "1.0",
  "description": "Turn web novels into book-like reading experience",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": ["*://*.novelbin.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Novel Book Reader"
  },
  "content_scripts": [
    {
      "matches": ["*://*.novelbin.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}